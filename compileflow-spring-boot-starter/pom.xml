<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.alibaba.compileflow</groupId>
        <artifactId>compileflow</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>compileflow-spring-boot-starter</artifactId>
    <name>CompileFlow Spring Boot Starter</name>
    <description>Spring Boot starter for embedding the CompileFlow engine.</description>

    <dependencies>
        <!-- Auto-configuration module -->
        <dependency>
            <groupId>com.alibaba.compileflow</groupId>
            <artifactId>compileflow-spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Spring Boot Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Opinionated default: TBBPM model (Alibaba's enterprise workflow spec).
             Users who need BPMN 2.0 instead should add compileflow-bpmn explicitly. -->
        <dependency>
            <groupId>com.alibaba.compileflow</groupId>
            <artifactId>compileflow-tbbpm</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- The dependency-only starter has no public runtime type, so javadoc cannot
                 generate a standard archive. Attach the documented Central placeholder below. -->
            <plugin>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-starter-javadoc</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.basedir}/src/javadoc</classesDirectory>
                            <classifier>javadoc</classifier>
                            <skipIfEmpty>false</skipIfEmpty>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
