<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:cf="http://www.compileflow.org"
             targetNamespace="http://www.compileflow.org/bpmn/test">
  <process id="bpmn20.gateway.exclusive_gateway" name="Exclusive Gateway Flow" isExecutable="true">
    <extensionElements>
      <cf:var name="flag" dataType="java.lang.Boolean" inOutType="param"/>
      <cf:var name="result" dataType="java.lang.String" inOutType="return"/>
    </extensionElements>
    <startEvent id="start" name="Start"/>
    <sequenceFlow id="flow1" sourceRef="start" targetRef="gateway1"/>
    <exclusiveGateway id="gateway1" name="Decision"/>
    <sequenceFlow id="flow2" sourceRef="gateway1" targetRef="serviceTask1">
      <conditionExpression xsi:type="tFormalExpression" language="java"><![CDATA[flag]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow3" sourceRef="gateway1" targetRef="serviceTask2">
      <conditionExpression xsi:type="tFormalExpression" language="java"><![CDATA[Boolean.FALSE.equals(flag)]]></conditionExpression>
    </sequenceFlow>
    <scriptTask id="serviceTask1" name="Script Task 1" scriptFormat="java">
      <extensionElements>
        <cf:output dataType="java.lang.String" target="result"/>
      </extensionElements>
      <script>return "task1";</script>
    </scriptTask>
    <scriptTask id="serviceTask2" name="Script Task 2" scriptFormat="java">
      <extensionElements>
        <cf:output dataType="java.lang.String" target="result"/>
      </extensionElements>
      <script>return "task2";</script>
    </scriptTask>
    <sequenceFlow id="flow4" sourceRef="serviceTask1" targetRef="end"/>
    <sequenceFlow id="flow5" sourceRef="serviceTask2" targetRef="end"/>
    <endEvent id="end" name="End"/>
  </process>
</definitions>
