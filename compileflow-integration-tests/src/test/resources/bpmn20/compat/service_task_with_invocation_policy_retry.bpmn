<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:cf="http://www.compileflow.org"
             targetNamespace="http://www.compileflow.org/bpmn/test">
  <process id="bpmn20.compat.service_task_with_invocation_policy_retry" name="Service Task with Retry Invocation Policy Test" isExecutable="true">
    <extensionElements>
      <cf:var name="a" dataType="java.lang.Integer" inOutType="param"/>
      <cf:var name="b" dataType="java.lang.Integer" inOutType="param"/>
      <cf:var name="result" dataType="java.lang.Integer" inOutType="return"/>
    </extensionElements>
    <startEvent id="start" name="Start"/>
    <sequenceFlow id="flow1" sourceRef="start" targetRef="serviceTask1"/>
    <serviceTask id="serviceTask1" name="Service Task with Retry">
      <extensionElements>
        <cf:action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                           method="add">
            <cf:input target="a" dataType="java.lang.Integer" source="a"/>
            <cf:input target="b" dataType="java.lang.Integer" source="b"/>
            <cf:output dataType="java.lang.Integer" target="result"/>


            <cf:invocationPolicy attemptTimeout="PT15S" maxAttempts="2" initialBackoff="PT3S" retryOn="never" onFailure="propagate"/>
        </cf:action>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flow2" sourceRef="serviceTask1" targetRef="end"/>
    <endEvent id="end" name="End"/>
  </process>
</definitions>
