<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:cf="http://www.compileflow.org/schema/1.0"
             targetNamespace="http://www.compileflow.org/bpmn/test">
  <process id="bpmn20.compat.call_activity" name="Call Activity Flow" isExecutable="true">
    <extensionElements>
      <cf:var name="inputValue" dataType="java.lang.Integer" inOutType="param"/>
      <cf:var name="outputValue" dataType="java.lang.Integer" inOutType="return"/>
    </extensionElements>
    
    <startEvent id="start" name="Start"/>
    <sequenceFlow id="flow1" sourceRef="start" targetRef="callActivity1"/>
    
    <callActivity id="callActivity1" name="Call Sub Process" calledElement="bpmn20.compat.simple_service">
      <extensionElements>
        <cf:var name="a" dataType="java.lang.Integer" contextVarName="inputValue" inOutType="param"/>
        <cf:var name="b" dataType="java.lang.Integer" contextVarName="inputValue" inOutType="param"/>
        <cf:var name="serviceTask1Result" dataType="java.lang.Integer" contextVarName="outputValue" inOutType="return"/>
      </extensionElements>
    </callActivity>
    
    <sequenceFlow id="flow2" sourceRef="callActivity1" targetRef="serviceTask1"/>
    
    <serviceTask id="serviceTask1" name="Process Result">
      <extensionElements>
        <cf:action type="java">
          <cf:actionHandle clazz="com.alibaba.compileflow.engine.test.mock.MockJavaClazz" method="multiply">
            <cf:var name="a" dataType="java.lang.Integer" contextVarName="outputValue" inOutType="param"/>
            <cf:var name="b" dataType="java.lang.Integer" contextVarName="2" inOutType="param"/>
            <cf:var name="result" dataType="java.lang.Integer" contextVarName="outputValue" inOutType="return"/>
          </cf:actionHandle>
        </cf:action>
      </extensionElements>
    </serviceTask>
    
    <sequenceFlow id="flow3" sourceRef="serviceTask1" targetRef="end"/>
    <endEvent id="end" name="End"/>
  </process>
</definitions>
