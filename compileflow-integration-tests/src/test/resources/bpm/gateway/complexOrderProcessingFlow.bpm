<?xml version="1.0" encoding="UTF-8" ?>
<bpm code="bpm.gateway.complexOrderProcessingFlow" name="Complex Order Processing Flow"
     description="超复杂订单处理流程：包含多层嵌套网关、并行处理、循环和分支合并，最终输出处理结果">

    <var name="orderId" dataType="java.lang.String" inOutType="param"/>
    <var name="processingSteps" description="处理步骤" dataType="java.lang.String" inOutType="inner"/>
    <var name="finalResult" dataType="java.lang.String" inOutType="return"/>


    <start id="start" name="开始" g="100,100,40,40">
        <transition to="InitializeOrder"/>
    </start>

    <autoTask id="InitializeOrder" name="初始化订单处理" g="150,100,100,48">
        <transition to="G0"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="processOrder">
                <input target="orderId" dataType="java.lang.String" source="orderId"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <exclusive id="G0" name="前置网关" g="200,100,88,48">
        <transition condition="true" name="主路径" to="G0Join"/>
        <transition condition="false" name="备用路径" to="AltPath"/>
    </exclusive>


    <autoTask id="AltPath" name="备用路径处理" g="300,150,100,48">
        <transition to="AltDecision"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="processOrder">
                <input target="orderId" dataType="java.lang.String" source="orderId"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>


    <exclusive id="AltDecision" name="备用决策" g="450,150,88,48">
        <transition condition="true" name="路径1" to="AltTask1"/>
        <transition condition="false" name="路径2" to="AltTask2"/>
    </exclusive>

    <autoTask id="AltTask1" name="备用任务1" g="600,130,100,48">
        <transition to="AltMerge"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="altTask1"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <autoTask id="AltTask2" name="备用任务2" g="600,170,100,48">
        <transition to="AltMerge"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="altTask2"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <autoTask id="AltMerge" name="备用合并" g="750,150,100,48">
        <transition to="G0Join"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="processOrder">
                <input target="orderId" dataType="java.lang.String" source="orderId"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>


    <exclusive id="G0Join" name="G0 汇合" g="250,100,48,48">
        <transition to="G1"/>
    </exclusive>

    <exclusive id="G1" name="网关 G1" g="300,50,88,48">
        <transition condition="true" name="路径A" to="A"/>
        <transition condition="false" name="路径X" to="X"/>
    </exclusive>


    <autoTask id="A" name="任务 A" g="400,30,88,48">
        <transition to="G1_1"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="altpath"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>


    <exclusive id="G1_1" name="嵌套网关1" g="500,30,88,48">
        <transition condition="true" name="子路径1" to="SubA1"/>
        <transition condition="false" name="子路径2" to="SubA2"/>
    </exclusive>

    <autoTask id="SubA1" name="子任务A1" g="600,10,100,48">
        <transition to="G1_1Join"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="subA1"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <autoTask id="SubA2" name="子任务A2" g="600,50,100,48">
        <transition to="G1_1Join"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="subA2"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <exclusive id="G1_1Join" name="G1_1 汇合" g="700,30,48,48">
        <transition to="G1_2"/>
    </exclusive>

    <exclusive id="G1_2" name="嵌套网关2" g="750,30,88,48">
        <transition condition="true" name="路径A1" to="SubA3"/>
        <transition condition="false" name="路径A2" to="SubA4"/>
    </exclusive>

    <autoTask id="SubA3" name="子任务A3" g="850,10,100,48">
        <transition to="MergeA"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="subA3"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <autoTask id="SubA4" name="子任务A4" g="850,50,100,48">
        <transition to="MergeA"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="subA4"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <autoTask id="MergeA" name="合并点A" g="1000,30,100,48">
        <transition to="G2"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="mergeA"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>


    <autoTask id="X" name="任务 X" g="400,150,88,48">
        <transition to="LoopStart"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="taskX"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>


    <autoTask id="LoopStart" name="循环开始" g="500,150,100,48">
        <transition to="LoopDecision"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="loopStart"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <exclusive id="LoopDecision" name="循环决策" g="650,150,88,48">
        <transition condition="true" name="继续循环" to="LoopTask"/>
        <transition condition="false" name="结束循环" to="LoopEnd"/>
    </exclusive>

    <autoTask id="LoopTask" name="循环任务" g="800,150,100,48">
        <transition to="LoopDecisionJoin"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="loopTask"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <autoTask id="LoopEnd" name="循环结束" g="950,150,100,48">
        <transition to="LoopDecisionJoin"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="loopEnd"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>


    <exclusive id="LoopDecisionJoin" name="循环决策汇合" g="1050,150,48,48">
        <transition to="G3"/>
    </exclusive>

    <exclusive id="G3" name="决策网关" g="1100,150,88,48">
        <transition condition="processingSteps != null &amp;&amp; processingSteps.length() &gt; 10" name="分支1"
                    to="Parallel1"/>
        <transition
                condition="processingSteps != null &amp;&amp; processingSteps.length() &lt;= 10 &amp;&amp; processingSteps.length() &gt; 5"
                name="分支2" to="Parallel2"/>
        <transition condition="processingSteps == null || processingSteps.length() &lt;= 5" name="分支3"
                    to="Parallel3"/>
    </exclusive>

    <autoTask id="Parallel1" name="决策任务1" g="1250,100,100,48">
        <transition to="MergeParallel"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="parallel1"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <autoTask id="Parallel2" name="决策任务2" g="1250,150,100,48">
        <transition to="MergeParallel"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="parallel2"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <autoTask id="Parallel3" name="决策任务3" g="1250,200,100,48">
        <transition to="MergeParallel"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="parallel3"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <autoTask id="MergeParallel" name="决策合并" g="1400,150,100,48">
        <transition to="G1Join"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="mergeParallel"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>


    <autoTask id="Y" name="任务 Y" g="1550,150,88,48">
        <transition to="end"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="finalizeResult">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <output dataType="java.lang.String" target="finalResult"/>

        </action>
    </autoTask>


    <exclusive id="G2" name="网关 G2" g="1100,30,88,48">
        <transition condition="true" name="路径B" to="B"/>
        <transition condition="false" name="路径C" to="C"/>
    </exclusive>


    <autoTask id="B" name="任务 B" g="1250,10,88,48">
        <transition to="G2_1"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="y"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>


    <exclusive id="G2_1" name="嵌套网关B" g="1400,10,88,48">
        <transition condition="true" name="子路径B1" to="SubB1"/>
        <transition condition="false" name="子路径B2" to="SubB2"/>
    </exclusive>

    <autoTask id="SubB1" name="子任务B1" g="1550,-10,100,48">
        <transition to="MergeB"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="subB1"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <autoTask id="SubB2" name="子任务B2" g="1550,30,100,48">
        <transition to="MergeB"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="subB2"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <autoTask id="MergeB" name="合并点B" g="1700,10,100,48">
        <transition to="J"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="mergeB"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>


    <autoTask id="C" name="任务 C" g="1250,50,88,48">
        <transition to="G2_2"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="taskC"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>


    <exclusive id="G2_2" name="嵌套网关C" g="1400,50,88,48">
        <transition condition="true" name="子路径C1" to="SubC1"/>
        <transition condition="false" name="子路径C2" to="SubC2"/>
    </exclusive>

    <autoTask id="SubC1" name="子任务C1" g="1550,30,100,48">
        <transition to="MergeC"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="subC1"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <autoTask id="SubC2" name="子任务C2" g="1550,70,100,48">
        <transition to="MergeC"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="subC2"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <autoTask id="MergeC" name="合并点C" g="1700,50,100,48">
        <transition to="J"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="mergeC"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>


    <autoTask id="J" name="任务 J" g="1850,30,88,48">
        <transition to="K"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="taskJ"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>


    <exclusive id="K" name="网关 K" g="2000,30,88,48">
        <transition condition="true" name="路径F" to="F"/>
        <transition condition="false" name="路径G" to="G"/>
    </exclusive>


    <autoTask id="F" name="任务 F" g="2150,10,88,48">
        <transition to="G4"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="taskF"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>


    <exclusive id="G4" name="后置网关" g="2300,10,88,48">
        <transition condition="true" name="路径F1" to="PostF1"/>
        <transition condition="false" name="路径F2" to="PostF2"/>
    </exclusive>

    <autoTask id="PostF1" name="后置任务F1" g="2450,-10,100,48">
        <transition to="MergeF"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="postF1"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <autoTask id="PostF2" name="后置任务F2" g="2450,30,100,48">
        <transition to="MergeF"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="postF2"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <autoTask id="MergeF" name="合并点F" g="2600,10,100,48">
        <transition to="H"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="mergeF"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>


    <autoTask id="G" name="任务 G" g="2150,50,88,48">
        <transition to="G5"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="taskG"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>


    <exclusive id="G5" name="后置网关" g="2300,50,88,48">
        <transition condition="true" name="路径G1" to="PostG1"/>
        <transition condition="false" name="路径G2" to="PostG2"/>
    </exclusive>

    <autoTask id="PostG1" name="后置任务G1" g="2450,30,100,48">
        <transition to="MergeG"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="postG1"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <autoTask id="PostG2" name="后置任务G2" g="2450,70,100,48">
        <transition to="MergeG"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="postG2"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <autoTask id="MergeG" name="合并点G" g="2600,50,100,48">
        <transition to="H"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="mergeG"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>


    <autoTask id="H" name="任务 H" g="2750,30,88,48">
        <transition to="FinalDecision"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="taskH"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>


    <exclusive id="FinalDecision" name="最终决策"
              g="2900,30,88,48">
        <transition condition="true" name="路径Y" to="FinalDecisionJoin"/>
        <transition condition="false" name="路径Z" to="Z"/>
    </exclusive>

    <autoTask id="Z" name="任务 Z" g="3050,30,88,48">
        <transition to="FinalDecisionJoin"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService" method="appendStep">
                <input target="path" dataType="java.lang.String" source="processingSteps"/>
                <input target="step" dataType="java.lang.String" defaultValue="taskZ"/>
                <output dataType="java.lang.String" target="processingSteps"/>

        </action>
    </autoTask>

    <exclusive id="FinalDecisionJoin" name="最终决策汇合"
              g="3120,30,48,48">
        <transition to="G1Join"/>
    </exclusive>

    <exclusive id="G1Join" name="G1 汇合"
              g="3180,30,48,48">
        <transition to="Y"/>
    </exclusive>


    <end id="end" name="结束" g="3200,30,40,40"/>
</bpm>
