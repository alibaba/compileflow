<?xml version="1.0" encoding="UTF-8"?>
<bpm code="bpm.gateway.simpleParallelGateway" name="Parallel Gateway Flow"
     description="并行计算流程：同时执行加法和乘法运算，输出两个结果">
    <var name="a" dataType="java.lang.Integer" defaultValue="1" inOutType="param"/>
    <var name="b" dataType="java.lang.Integer" defaultValue="2" inOutType="param"/>
    <var name="serviceTask1Result" dataType="java.lang.Integer" inOutType="return"/>
    <var name="serviceTask2Result" dataType="java.lang.Integer" inOutType="return"/>

    <start id="start" name="Start" g="50,50,32,32">
        <transition to="fork"/>
    </start>

    <parallel id="fork" name="并行分支" g="150,40,48,48">
        <transition to="serviceTask1"/>
        <transition to="serviceTask2"/>
    </parallel>

    <autoTask id="serviceTask1" name="加法计算" g="260,10,120,48">
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="add">
                <input target="a" dataType="java.lang.Integer" source="a"/>
                <input target="b" dataType="java.lang.Integer" source="b"/>
                <output dataType="java.lang.Integer" target="serviceTask1Result"/>

        </action>
        <transition to="join"/>
    </autoTask>

    <autoTask id="serviceTask2" name="乘法计算" g="260,80,120,48">
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="multiply">

                <input target="a" dataType="java.lang.Integer" source="a"/>
                <input target="b" dataType="java.lang.Integer" source="b"/>
                <output dataType="java.lang.Integer" target="serviceTask2Result"/>

        </action>
        <transition to="join"/>
    </autoTask>

    <parallel id="join" name="并行合并" g="400,40,48,48">
        <transition to="end"/>
    </parallel>

    <end id="end" name="End" g="500,50,32,32"/>
</bpm>
