<?xml version="1.0" encoding="UTF-8"?>
<bpm code="bpm.javacode.javaInline" name="Simple Calculator (Java Inline)" type="process"
     description="Basic calculator using java-inline action">
    <var name="inputA" description="First Number" dataType="java.lang.Integer" inOutType="param"/>
    <var name="inputB" description="Second Number" dataType="java.lang.Integer" inOutType="param"/>
    <var name="operation" description="Operation Type" dataType="java.lang.String" inOutType="param"/>
    <var name="result" description="Calculation Result" dataType="java.lang.Integer" inOutType="return"/>

    <start id="start" name="Start" g="50,50,32,32">
        <transition to="calculateTask"/>
    </start>

    <autoTask id="calculateTask" name="Calculate (Java Inline)" g="150,40,180,48">
        <action type="java-inline">
            <actionHandle>
                <imports>
                    <import>java.util.Objects</import>
                </imports>
                <code mode="block"><![CDATA[
                    // Inputs: a, b, operation; Output: result
                    // Expect non-null inputs; throw on invalid op / divide-by-zero.
                    if (a == null || b == null) {
                        throw new IllegalArgumentException("inputA/inputB must not be null");
                    }
                    int r;
                    switch (operation) {
                        case "+": r = a + b; break;
                        case "-": r = a - b; break;
                        case "*": r = a * b; break;
                        case "/":
                            if (b == 0) throw new ArithmeticException("divide by zero");
                            r = a / b; break;
                        default:
                            throw new IllegalArgumentException("Unsupported op: " + operation);
                    }
                    // Assign to the declared return var
                    result = r;
                ]]></code>

                <var name="a" dataType="java.lang.Integer" inOutType="param" contextVarName="inputA"/>
                <var name="b" dataType="java.lang.Integer" inOutType="param" contextVarName="inputB"/>
                <var name="operation" dataType="java.lang.String" inOutType="param" contextVarName="operation"/>
                <var name="result" dataType="java.lang.Integer" inOutType="return" contextVarName="result"/>
            </actionHandle>
        </action>

        <transition to="end"/>
    </autoTask>

    <end id="end" name="End" g="380,50,32,32"/>
</bpm>
