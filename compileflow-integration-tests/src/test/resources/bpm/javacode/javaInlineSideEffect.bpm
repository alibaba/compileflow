<?xml version="1.0" encoding="UTF-8"?>
<bpm code="bpm.javacode.javaInlineSideEffect" name="Inline Expr Side-Effect" type="process"
     description="java-inline expr mode without return var; side-effect only">
    <var name="inputA" dataType="java.lang.Integer" inOutType="param"/>
    <var name="inputB" dataType="java.lang.Integer" inOutType="param"/>

    <start id="start" name="Start" g="50,50,32,32">
        <transition to="log"/>
    </start>

    <autoTask id="log" name="Log (inline expr)" g="150,40,220,48">
        <action type="java-inline">
            <actionHandle>
                <!-- 没有 return 变量，表达式会被当作语句执行；这里做日志输出等副作用 -->
                <code mode="expr"><![CDATA[
          System.out.println("sum=" + (a + b))
        ]]></code>

                <var name="a" dataType="java.lang.Integer" inOutType="param" contextVarName="inputA"/>
                <var name="b" dataType="java.lang.Integer" inOutType="param" contextVarName="inputB"/>
            </actionHandle>
        </action>
        <transition to="end"/>
    </autoTask>

    <end id="end" name="End" g="400,50,32,32"/>
</bpm>
