<?xml version="1.0" encoding="UTF-8"?>
<bpm code="bpm.javacode.javaInlineBlock" name="Inline Block Calculator" type="process"
     description="java-inline block mode, with imports and validations">
    <var name="inputA" dataType="java.lang.Integer" inOutType="param"/>
    <var name="inputB" dataType="java.lang.Integer" inOutType="param"/>
    <var name="op" dataType="java.lang.String" inOutType="param"/>
    <var name="result" dataType="java.lang.Integer" inOutType="return"/>

    <start id="start" name="Start" g="50,50,32,32">
        <transition to="calc"/>
    </start>

    <autoTask id="calc" name="Calc (inline block)" g="150,40,200,48">
        <action type="java-inline">
            <actionHandle>
                <imports>
                    <import>java.util.Objects</import>
                </imports>
                <code mode="block"><![CDATA[
                      Objects.requireNonNull(a, "a must not be null");
                      Objects.requireNonNull(b, "b must not be null");

                      int r;
                      switch (op) {
                        case "+": r = a + b; break;
                        case "-": r = a - b; break;
                        case "*": r = a * b; break;
                        case "/":
                          if (b == 0) throw new ArithmeticException("divide by zero");
                          r = a / b; break;
                        default: throw new IllegalArgumentException("unsupported op: " + op);
                      }
                      result = r;
                    ]]>
                </code>

                <var name="a" dataType="java.lang.Integer" inOutType="param" contextVarName="inputA"/>
                <var name="b" dataType="java.lang.Integer" inOutType="param" contextVarName="inputB"/>
                <var name="op" dataType="java.lang.String" inOutType="param" contextVarName="op"/>
                <var name="result" dataType="java.lang.Integer" inOutType="return" contextVarName="result"/>
            </actionHandle>
        </action>
        <transition to="end"/>
    </autoTask>

    <end id="end" name="End" g="380,50,32,32"/>
</bpm>
