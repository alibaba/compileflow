<?xml version="1.0" encoding="UTF-8"?>
<bpm code="bpm.invocation-policy.retryTransientFailures" name="InvocationPolicy Retry Test - Transient Failures">
    <var name="failUntilAttempt" dataType="java.lang.Integer" defaultValue="2" inOutType="param"/>
    <var name="result" dataType="java.lang.String" inOutType="return"/>

    <start id="start" name="Start" g="50,50,32,32">
        <transition to="retryTask"/>
    </start>

    <autoTask id="retryTask" name="Retry Task" g="150,40,120,48">
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.InvocationPolicyTestService"
                          method="retryableTask">
                <input target="failUntilAttempt" dataType="java.lang.Integer" source="failUntilAttempt"/>
                <output dataType="java.lang.String" target="result"/>


            <invocationPolicy
                attemptTimeout="PT1S"
                maxAttempts="3" initialBackoff="PT0.2S"
                retryOn="always"
                onFailure="propagate"/>
        </action>
        <transition to="end"/>
    </autoTask>

    <end id="end" name="End" g="320,50,32,32"/>
</bpm>
