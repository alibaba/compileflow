<?xml version="1.0" encoding="UTF-8"?>
<bpm code="bpm.invocation-policy.fullConfiguration" name="InvocationPolicy Full Configuration Test">
    <var name="result" dataType="java.lang.String" inOutType="return"/>

    <start id="start" name="Start" g="50,50,32,32">
        <transition to="fullConfigTask"/>
    </start>

    <autoTask id="fullConfigTask" name="Full Configuration Task" g="150,40,120,48">
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.InvocationPolicyTestService"
                          method="defaultedValue">
                <input target="value" dataType="java.lang.Integer" defaultValue="7"/>
                <output dataType="java.lang.String" target="result"/>


            <invocationPolicy
                attemptTimeout="PT5S"
                maxAttempts="3" initialBackoff="PT0.2S"
                retryOn="transient"
                onFailure="propagate"/>
        </action>
        <transition to="end"/>
    </autoTask>

    <end id="end" name="End" g="320,50,32,32"/>
</bpm>
