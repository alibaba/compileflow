<?xml version="1.0" encoding="UTF-8"?>
<bpm code="bpm.jobpolicy.retryNeverPolicy" name="JobPolicy Retry Test - Never Policy" type="process">
    <var name="result" dataType="java.lang.String" inOutType="return"/>

    <start id="start" name="Start" g="50,50,32,32">
        <transition to="noRetryTask"/>
    </start>

    <autoTask id="noRetryTask" name="No Retry Task" g="150,40,120,48">
        <jobPolicy
                timeout="PT1S"
                retry="R0/PT0S"
                retryOn="never"
                onFailure="incident"/>
        <action type="java">
            <actionHandle clazz="com.alibaba.compileflow.engine.test.mock.JobPolicyTestService"
                          method="deterministicFailure">
                <var name="result" dataType="java.lang.String" inOutType="return" contextVarName="result"/>
            </actionHandle>
        </action>
        <transition to="end"/>
    </autoTask>

    <end id="end" name="End" g="320,50,32,32"/>
</bpm>
