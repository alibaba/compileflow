<?xml version='1.0' encoding='UTF-8'?>
<bpm code="bpm.order-management.waitPaySuccessFlow" name="等待支付成功流程"
     description="支付成功等待流程：计算订单金额并等待支付成功事件触发">
    <var name="num" dataType="java.lang.Integer" inOutType="param"/>
    <var name="numSqrt" dataType="java.lang.Integer" inOutType="return"/>
    <start id="1" name="开始" g="115,16,30,30">
        <transition to="17" g=":-15,20"/>
    </start>
    <end id="11" name="结束" g="130,815,30,30"/>
    <autoTask id="17" name="计算平方根" g="95,160,88,48">
        <transition to="29" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="getMockReturnValue">
                <input target="num" dataType="java.lang.Integer" source="num"/>
                <output dataType="java.lang.Integer" target="numSqrt"/>

        </action>
    </autoTask>
    <waitEventTask id="29" name="֧等待支付成功事件" event="PaymentPendingCallback"
                   g="100,370,101,53">
        <transition to="38" g=":-15,20"/>
    </waitEventTask>
    <autoTask id="38" name="计算价格2" g="95,545,88,48">
        <transition to="11" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="calculatePrice">
                <input target="num" dataType="java.lang.Integer" source="num"/>
                <output dataType="java.lang.Integer" target="numSqrt"/>

        </action>
    </autoTask>
</bpm>
