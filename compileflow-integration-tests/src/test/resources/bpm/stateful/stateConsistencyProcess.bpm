<?xml version="1.0" encoding="UTF-8"?>
<bpm code="bpm.stateful.stateConsistencyProcess" name="状态一致性流程"
     description="测试状态一致性的stateful流程">
    <var name="sessionId" dataType="java.lang.String" inOutType="param"/>
    <var name="userId" dataType="java.lang.String" inOutType="param"/>
    <var name="initial_data" dataType="java.lang.String" inOutType="param"/>
    <var name="update_data" dataType="java.lang.String" inOutType="param"/>
    <var name="finalize_data" dataType="java.lang.String" inOutType="param"/>
    <var name="stateData" dataType="java.lang.String" inOutType="return"/>
    <var name="updatedStateData" dataType="java.lang.String" inOutType="return"/>
    <var name="finalStateData" dataType="java.lang.String" inOutType="return"/>

    <start id="start" name="开始" g="100,50,30,30">
        <transition to="initializeState" g=":-15,20"/>
    </start>

    <autoTask id="initializeState" name="初始化状态" g="80,120,88,48">
        <transition to="waitInitialization" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="processTask">
                <input target="task" dataType="java.lang.String" source="sessionId"/>
                <output dataType="java.lang.String" target="sessionId"/>

        </action>
    </autoTask>

    <waitEventTask id="waitInitialization" name="等待初始化" event="initializationComplete"
                   g="70,200,120,60">
        <transition to="processInitialization" g=":-15,20"/>
    </waitEventTask>

    <autoTask id="processInitialization" name="处理初始化" g="80,300,88,48">
        <transition to="waitStateUpdate" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="combineResults">
                <input target="payment" dataType="java.lang.String" source="sessionId"/>
                <input target="delivery" dataType="java.lang.String" source="stateData"/>
                <output dataType="java.lang.String" target="stateData"/>

        </action>
    </autoTask>

    <waitEventTask id="waitStateUpdate" name="等待状态更新" event="stateUpdateComplete"
                   g="70,400,120,60">
        <transition to="processStateUpdate" g=":-15,20"/>
    </waitEventTask>

    <autoTask id="processStateUpdate" name="处理状态更新" g="80,500,88,48">
        <transition to="waitStateFinalization" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="combineResults">
                <input target="payment" dataType="java.lang.String" source="stateData"/>
                <input target="delivery" dataType="java.lang.String" source="updatedStateData"/>
                <output dataType="java.lang.String" target="updatedStateData"/>

        </action>
    </autoTask>

    <waitEventTask id="waitStateFinalization" name="等待状态完成"
                   event="stateFinalizationComplete" g="70,600,120,60">
        <transition to="processStateFinalization" g=":-15,20"/>
    </waitEventTask>

    <autoTask id="processStateFinalization" name="处理状态完成" g="80,700,88,48">
        <transition to="end" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="combineResults">
                <input target="payment" dataType="java.lang.String" source="updatedStateData"/>
                <input target="delivery" dataType="java.lang.String" source="finalStateData"/>
                <output dataType="java.lang.String" target="finalStateData"/>

        </action>
    </autoTask>

    <end id="end" name="结束" g="100,800,30,30"/>
</bpm>

