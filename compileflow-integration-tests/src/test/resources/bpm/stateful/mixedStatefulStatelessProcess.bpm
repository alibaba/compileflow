<?xml version="1.0" encoding="UTF-8"?>
<bpm code="bpm.stateful.mixedStatefulStatelessProcess" name="混合状态无状态流程"
     description="测试混合状态和无状态节点的stateful流程">
    <var name="processData" dataType="java.lang.String" inOutType="param"/>
    <var name="stateful_trigger_data" dataType="java.lang.String" inOutType="param"/>
    <var name="statelessResult" dataType="java.lang.String" inOutType="param"/>
    <var name="statefulResult" dataType="java.lang.String" inOutType="param"/>
    <var name="mixedResult" dataType="java.lang.String" inOutType="return"/>

    <start id="start" name="开始" g="100,50,30,30">
        <transition to="statelessTask" g=":-15,20"/>
    </start>

    <autoTask id="statelessTask" name="无状态任务" g="80,120,88,48">
        <transition to="waitStatefulEvent" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="processStep">
                <input target="input" dataType="java.lang.String" source="processData"/>
                <output dataType="java.lang.String" target="statelessResult"/>

        </action>
    </autoTask>

    <waitEventTask id="waitStatefulEvent" name="等待状态事件" event="statefulEventComplete"
                   g="70,200,120,60">
        <transition to="processStatefulResult" g=":-15,20"/>
    </waitEventTask>

    <autoTask id="processStatefulResult" name="处理状态结果" g="80,300,88,48">
        <transition to="combineMixedResults" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="combineResults">
                <input target="payment" dataType="java.lang.String" source="statelessResult"/>
                <input target="delivery" dataType="java.lang.String" source="statefulResult"/>
                <output dataType="java.lang.String" target="mixedResult"/>

        </action>
    </autoTask>

    <autoTask id="combineMixedResults" name="合并混合结果" g="80,400,88,48">
        <transition to="end" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="finalizeResult">
                <input target="path" dataType="java.lang.String" source="mixedResult"/>
                <output dataType="java.lang.String" target="mixedResult"/>

        </action>
    </autoTask>

    <end id="end" name="结束" g="100,500,30,30"/>
</bpm>

