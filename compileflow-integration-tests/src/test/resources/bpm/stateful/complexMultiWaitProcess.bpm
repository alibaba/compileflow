<?xml version="1.0" encoding="UTF-8"?>
<bpm code="bpm.stateful.complexMultiWaitProcess" name="复杂多等待流程"
     description="测试复杂多等待的stateful流程">
    <var name="processId" dataType="java.lang.String" inOutType="param"/>
    <var name="step1_data" dataType="java.lang.String" inOutType="param"/>
    <var name="step2_data" dataType="java.lang.String" inOutType="param"/>
    <var name="step3_data" dataType="java.lang.String" inOutType="param"/>
    <var name="step4_data" dataType="java.lang.String" inOutType="param"/>
    <var name="step5_data" dataType="java.lang.String" inOutType="param"/>
    <var name="finalComplexResult" dataType="java.lang.String" inOutType="return"/>

    <start id="start" name="开始" g="100,50,30,30">
        <transition to="initializeComplexProcess" g=":-15,20"/>
    </start>

    <autoTask id="initializeComplexProcess" name="初始化复杂流程" g="80,120,88,48">
        <transition to="waitStep1" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="processTask">
                <input target="task" dataType="java.lang.String" source="processId"/>
                <output dataType="java.lang.String" target="processId"/>

        </action>
    </autoTask>

    <waitEventTask id="waitStep1" name="等待步骤1" event="step1Complete" g="70,200,120,60">
        <transition to="processStep1" g=":-15,20"/>
    </waitEventTask>

    <autoTask id="processStep1" name="处理步骤1" g="80,300,88,48">
        <transition to="waitStep2" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="combineResults">
                <input target="payment" dataType="java.lang.String" source="processId"/>
                <input target="delivery" dataType="java.lang.String" source="step1_data"/>
                <output dataType="java.lang.String" target="step1_data"/>

        </action>
    </autoTask>

    <waitEventTask id="waitStep2" name="等待步骤2" event="step2Complete" g="70,400,120,60">
        <transition to="processStep2" g=":-15,20"/>
    </waitEventTask>

    <autoTask id="processStep2" name="处理步骤2" g="80,500,88,48">
        <transition to="waitStep3" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="combineResults">
                <input target="payment" dataType="java.lang.String" source="step1_data"/>
                <input target="delivery" dataType="java.lang.String" source="step2_data"/>
                <output dataType="java.lang.String" target="step2_data"/>

        </action>
    </autoTask>

    <waitEventTask id="waitStep3" name="等待步骤3" event="step3Complete" g="70,600,120,60">
        <transition to="processStep3" g=":-15,20"/>
    </waitEventTask>

    <autoTask id="processStep3" name="处理步骤3" g="80,700,88,48">
        <transition to="waitStep4" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="combineResults">
                <input target="payment" dataType="java.lang.String" source="step2_data"/>
                <input target="delivery" dataType="java.lang.String" source="step3_data"/>
                <output dataType="java.lang.String" target="step3_data"/>

        </action>
    </autoTask>

    <waitEventTask id="waitStep4" name="等待步骤4" event="step4Complete" g="70,800,120,60">
        <transition to="processStep4" g=":-15,20"/>
    </waitEventTask>

    <autoTask id="processStep4" name="处理步骤4" g="80,900,88,48">
        <transition to="waitStep5" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="combineResults">
                <input target="payment" dataType="java.lang.String" source="step3_data"/>
                <input target="delivery" dataType="java.lang.String" source="step4_data"/>
                <output dataType="java.lang.String" target="step4_data"/>

        </action>
    </autoTask>

    <waitEventTask id="waitStep5" name="等待步骤5" event="step5Complete" g="70,1000,120,60">
        <transition to="processStep5" g=":-15,20"/>
    </waitEventTask>

    <autoTask id="processStep5" name="处理步骤5" g="80,1100,88,48">
        <transition to="finalizeComplexProcess" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="combineResults">
                <input target="payment" dataType="java.lang.String" source="step4_data"/>
                <input target="delivery" dataType="java.lang.String" source="step5_data"/>
                <output dataType="java.lang.String" target="finalComplexResult"/>

        </action>
    </autoTask>

    <autoTask id="finalizeComplexProcess" name="完成复杂流程" g="80,1200,88,48">
        <transition to="end" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="finalizeResult">
                <input target="path" dataType="java.lang.String" source="finalComplexResult"/>
                <output dataType="java.lang.String" target="finalComplexResult"/>

        </action>
    </autoTask>

    <end id="end" name="结束" g="100,1300,30,30"/>
</bpm>

