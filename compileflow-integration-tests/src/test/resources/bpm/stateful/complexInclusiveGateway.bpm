<?xml version="1.0" encoding="UTF-8"?>
<bpm code="bpm.stateful.complexInclusiveGateway" name="复杂包含网关流程"
     description="测试复杂包含网关的stateful流程">
    <var name="orderType" dataType="java.lang.String" inOutType="param"/>
    <var name="customerTier" dataType="java.lang.String" inOutType="param"/>
    <var name="hasSpecialRequests" dataType="java.lang.Boolean" inOutType="param"/>
    <var name="premium_processing_result" dataType="java.lang.String" inOutType="param"/>
    <var name="loyalty_rewards_result" dataType="java.lang.String" inOutType="param"/>
    <var name="special_handling_result" dataType="java.lang.String" inOutType="param"/>
    <var name="standard_processing_result" dataType="java.lang.String" inOutType="param"/>
    <var name="combinedResult" dataType="java.lang.String" inOutType="return"/>

    <start id="start" name="开始" g="100,50,30,30">
        <transition to="evaluateOrder" g=":-15,20"/>
    </start>

    <autoTask id="evaluateOrder" name="评估订单" g="80,120,88,48">
        <transition to="inclusiveGateway" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="processStep">
                <input target="input" dataType="java.lang.String" source="orderType"/>
                <output dataType="java.lang.String" target="orderType"/>

        </action>
    </autoTask>

    <inclusive id="inclusiveGateway" name="包含网关" g="80,200,88,48">
        <transition to="waitPremiumProcessing" name="高级处理"
                    condition="orderType.equals(&quot;premium&quot;)" g=":-15,20"/>
        <transition to="waitLoyaltyRewards" name="忠诚度奖励"
                    condition="customerTier.equals(&quot;gold&quot;) || customerTier.equals(&quot;platinum&quot;)"
                    g=":-15,20"/>
        <transition to="waitSpecialHandling" name="特殊处理"
                    condition="hasSpecialRequests" g=":-15,20"/>
        <transition to="waitStandardProcessing" name="标准处理"
                    condition="orderType.equals(&quot;standard&quot;)" g=":-15,20"/>
    </inclusive>

    <waitEventTask id="waitPremiumProcessing" name="等待高级处理"
                   event="premiumProcessingComplete" g="70,300,120,60">
        <transition to="joinInclusiveGateway" g=":-15,20"/>
    </waitEventTask>

    <waitEventTask id="waitLoyaltyRewards" name="等待忠诚度奖励" event="loyaltyRewardsComplete"
                   g="70,400,120,60">
        <transition to="joinInclusiveGateway" g=":-15,20"/>
    </waitEventTask>

    <waitEventTask id="waitSpecialHandling" name="等待特殊处理"
                   event="specialHandlingComplete" g="70,500,120,60">
        <transition to="joinInclusiveGateway" g=":-15,20"/>
    </waitEventTask>

    <waitEventTask id="waitStandardProcessing" name="等待标准处理"
                   event="standardProcessingComplete" g="70,600,120,60">
        <transition to="joinInclusiveGateway" g=":-15,20"/>
    </waitEventTask>

    <inclusive id="joinInclusiveGateway" name="汇合包含网关" g="80,700,88,48">
        <transition to="combineResults" g=":-15,20"/>
    </inclusive>

    <autoTask id="combineResults" name="合并结果" g="80,800,88,48">
        <transition to="end" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="combineResults">
                <input target="payment" dataType="java.lang.String" source="orderType"/>
                <input target="delivery" dataType="java.lang.String" source="customerTier"/>
                <output dataType="java.lang.String" target="combinedResult"/>

        </action>
    </autoTask>

    <end id="end" name="结束" g="100,900,30,30"/>
</bpm>
