<?xml version="1.0" encoding="UTF-8"?>
<bpm code="bpm.stateful.complexParallelGateway" name="复杂并行网关流程"
     description="测试复杂并行网关的stateful流程">
    <var name="orderId" dataType="java.lang.String" inOutType="param"/>
    <var name="customerId" dataType="java.lang.String" inOutType="param"/>
    <var name="payment_status" dataType="java.lang.String" inOutType="param"/>
    <var name="payment_method" dataType="java.lang.String" inOutType="param"/>
    <var name="inventory_status" dataType="java.lang.String" inOutType="param"/>
    <var name="reserved_quantity" dataType="java.lang.Integer" inOutType="param"/>
    <var name="validation_status" dataType="java.lang.String" inOutType="param"/>
    <var name="customer_tier" dataType="java.lang.String" inOutType="param"/>
    <var name="finalResult" dataType="java.lang.String" inOutType="return"/>

    <start id="start" name="开始" g="100,50,30,30">
        <transition to="createOrder" g=":-15,20"/>
    </start>

    <autoTask id="createOrder" name="创建订单" g="80,120,88,48">
        <transition to="parallelGateway" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="processOrder">
                <input target="orderId" dataType="java.lang.String" source="orderId"/>
                <output dataType="java.lang.String" target="orderId"/>

        </action>
    </autoTask>

    <parallel id="parallelGateway" name="并行网关" g="80,200,88,48">
        <transition to="waitPaymentProcessing" g=":-15,20"/>
        <transition to="waitInventoryCheck" g=":-15,20"/>
        <transition to="waitCustomerValidation" g=":-15,20"/>
    </parallel>

    <waitEventTask id="waitPaymentProcessing" name="等待支付处理" event="paymentComplete"
                   g="70,300,120,60">
        <transition to="joinGateway" g=":-15,20"/>
    </waitEventTask>

    <waitEventTask id="waitInventoryCheck" name="等待库存检查" event="inventoryComplete"
                   g="70,400,120,60">
        <transition to="joinGateway" g=":-15,20"/>
    </waitEventTask>

    <waitEventTask id="waitCustomerValidation" name="等待客户验证"
                   event="validationComplete" g="70,500,120,60">
        <transition to="joinGateway" g=":-15,20"/>
    </waitEventTask>

    <parallel id="joinGateway" name="汇合网关" g="80,600,88,48">
        <transition to="processFinalResult" g=":-15,20"/>
    </parallel>

    <autoTask id="processFinalResult" name="处理最终结果" g="80,700,88,48">
        <transition to="end" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="combineResults">
                <input target="payment" dataType="java.lang.String" source="payment_status"/>
                <input target="delivery" dataType="java.lang.String" source="inventory_status"/>
                <output dataType="java.lang.String" target="finalResult"/>

        </action>
    </autoTask>

    <end id="end" name="结束" g="100,800,30,30"/>
</bpm>
