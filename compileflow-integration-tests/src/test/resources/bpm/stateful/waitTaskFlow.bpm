<?xml version="1.0" encoding="UTF-8"?>
<bpm code="bpm.stateful.waitTaskFlow" name="等待任务流程" type="statefulProcess"
     description="测试waitTask节点的stateful流程">
    <var name="taskData" description="任务数据" dataType="java.lang.String" inOutType="param"/>
    <var name="waitResult" description="等待结果" dataType="java.lang.String" inOutType="return"/>
    <var name="processedData" description="处理后数据" dataType="java.lang.String" inOutType="inner"/>

    <start id="start" name="开始" tag="start" g="100,50,30,30">
        <transition to="prepareTask" g=":-15,20"/>
    </start>

    <autoTask id="prepareTask" name="准备任务" tag="prepareTask" g="80,120,88,48">
        <transition to="waitTask1" g=":-15,20"/>
        <action type="java">
            <actionHandle clazz="com.alibaba.compileflow.engine.test.mock.MockJavaClazz" method="processString">
                <var name="input" dataType="java.lang.String" contextVarName="taskData" inOutType="param"/>
                <var name="result" dataType="java.lang.String" contextVarName="processedData" inOutType="return"/>
            </actionHandle>
        </action>
    </autoTask>

    <waitTask id="waitTask1" name="等待外部任务完成" tag="waitForExternalTask" g="70,200,120,60">
        <transition to="processResult" g=":-15,20"/>
        <inAction type="java">
            <actionHandle clazz="com.alibaba.compileflow.engine.test.mock.MockJavaClazz" method="processString">
                <var name="input" dataType="java.lang.String" contextVarName="processedData" inOutType="param"/>
                <var name="result" dataType="java.lang.String" contextVarName="waitResult" inOutType="return"/>
            </actionHandle>
        </inAction>
        <outAction type="java">
            <actionHandle clazz="com.alibaba.compileflow.engine.test.mock.MockJavaClazz" method="echo">
                <var name="value" dataType="java.lang.String" contextVarName="taskData" inOutType="param"/>
            </actionHandle>
        </outAction>
    </waitTask>

    <autoTask id="processResult" name="处理结果" tag="processResult" g="80,300,88,48">
        <transition to="end" g=":-15,20"/>
        <action type="java">
            <actionHandle clazz="com.alibaba.compileflow.engine.test.mock.MockJavaClazz" method="processString">
                <var name="input" dataType="java.lang.String" contextVarName="taskData" inOutType="param"/>
                <var name="result" dataType="java.lang.String" contextVarName="waitResult" inOutType="return"/>
            </actionHandle>
        </action>
    </autoTask>

    <end id="end" name="结束" tag="end" g="100,380,30,30"/>
</bpm>


