<?xml version="1.0" encoding="UTF-8"?>
<bpm code="bpm.stateful.deeplyNestedStatefulProcess" name="深度嵌套状态流程"
     description="测试深度嵌套状态流程的stateful流程">
    <var name="mainProcessData" dataType="java.lang.String" inOutType="param"/>
    <var name="subProcessLevel1Data" dataType="java.lang.String" inOutType="param"/>
    <var name="subProcessLevel2Data" dataType="java.lang.String" inOutType="param"/>
    <var name="level1_trigger_data" dataType="java.lang.String" inOutType="param"/>
    <var name="level2_trigger_data" dataType="java.lang.String" inOutType="param"/>
    <var name="level3_trigger_data" dataType="java.lang.String" inOutType="param"/>
    <var name="finalNestedResult" dataType="java.lang.String" inOutType="return"/>

    <start id="start" name="开始" g="100,50,30,30">
        <transition to="initializeMainProcess" g=":-15,20"/>
    </start>

    <autoTask id="initializeMainProcess" name="初始化主流程" g="80,120,88,48">
        <transition to="waitLevel1Event" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="processTask">
                <input target="task" dataType="java.lang.String" source="mainProcessData"/>
                <output dataType="java.lang.String" target="mainProcessData"/>

        </action>
    </autoTask>

    <waitEventTask id="waitLevel1Event" name="等待1级事件" event="level1EventComplete"
                   g="70,200,120,60">
        <transition to="processLevel1" g=":-15,20"/>
    </waitEventTask>

    <autoTask id="processLevel1" name="处理1级" g="80,300,88,48">
        <transition to="waitLevel2Event" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="combineResults">
                <input target="payment" dataType="java.lang.String" source="mainProcessData"/>
                <input target="delivery" dataType="java.lang.String" source="level1_trigger_data"/>
                <output dataType="java.lang.String" target="subProcessLevel1Data"/>

        </action>
    </autoTask>

    <waitEventTask id="waitLevel2Event" name="等待2级事件" event="level2EventComplete"
                   g="70,400,120,60">
        <transition to="processLevel2" g=":-15,20"/>
    </waitEventTask>

    <autoTask id="processLevel2" name="处理2级" g="80,500,88,48">
        <transition to="waitLevel3Event" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="combineResults">
                <input target="payment" dataType="java.lang.String" source="subProcessLevel1Data"/>
                <input target="delivery" dataType="java.lang.String" source="level2_trigger_data"/>
                <output dataType="java.lang.String" target="subProcessLevel2Data"/>

        </action>
    </autoTask>

    <waitEventTask id="waitLevel3Event" name="等待3级事件" event="level3EventComplete"
                   g="70,600,120,60">
        <transition to="processLevel3" g=":-15,20"/>
    </waitEventTask>

    <autoTask id="processLevel3" name="处理3级" g="80,700,88,48">
        <transition to="finalizeProcess" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="combineResults">
                <input target="payment" dataType="java.lang.String" source="subProcessLevel2Data"/>
                <input target="delivery" dataType="java.lang.String" source="level3_trigger_data"/>
                <output dataType="java.lang.String" target="finalNestedResult"/>

        </action>
    </autoTask>

    <autoTask id="finalizeProcess" name="完成流程" g="80,800,88,48">
        <transition to="end" g=":-15,20"/>
        <action type="java" class="com.alibaba.compileflow.engine.test.support.mocks.MockJavaService"
                          method="finalizeResult">
                <input target="path" dataType="java.lang.String" source="finalNestedResult"/>
                <output dataType="java.lang.String" target="finalNestedResult"/>

        </action>
    </autoTask>

    <end id="end" name="结束" g="100,900,30,30"/>
</bpm>

