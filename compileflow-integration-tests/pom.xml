<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.alibaba.compileflow</groupId>
        <artifactId>compileflow</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>compileflow-integration-tests</artifactId>
    <name>compileflow-integration-tests</name>
    <description>Test module for CompileFlow engine</description>

    <dependencies>
        <!-- API module -->
        <dependency>
            <groupId>com.alibaba.compileflow</groupId>
            <artifactId>compileflow-api</artifactId>
        </dependency>

        <!-- Core module -->
        <dependency>
            <groupId>com.alibaba.compileflow</groupId>
            <artifactId>compileflow-core</artifactId>
        </dependency>

        <!-- BPMN module -->
        <dependency>
            <groupId>com.alibaba.compileflow</groupId>
            <artifactId>compileflow-bpmn</artifactId>
        </dependency>

        <!-- TBBPM module -->
        <dependency>
            <groupId>com.alibaba.compileflow</groupId>
            <artifactId>compileflow-tbbpm</artifactId>
        </dependency>

        <!-- Deploy module: hot deploy + change detectors -->
        <dependency>
            <groupId>com.alibaba.compileflow</groupId>
            <artifactId>compileflow-deploy</artifactId>
        </dependency>

        <!-- Spring Boot auto-configuration (for Spring Boot tests) -->
        <dependency>
            <groupId>com.alibaba.compileflow</groupId>
            <artifactId>compileflow-spring-boot-autoconfigure</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot test support (includes JUnit 5, Mockito, Spring Test) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
