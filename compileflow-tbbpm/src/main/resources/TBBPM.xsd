<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- ========= Simple Types ========= -->

    <!-- Retry cycle: require an explicit non-negative count; disallow infinite (no count) -->
    <xs:simpleType name="RetryCycle">
        <xs:restriction base="xs:string">
            <!-- R0/PT5S, R3/PT0.2S, etc.; but not R/PT5S -->
            <xs:pattern value="R(0|[1-9]\d*)\/P.+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TimeCycle">
        <xs:restriction base="xs:string">
            <xs:pattern value="R(0|[1-9]\d*)\/P.+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="RetryOnEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="transient"/>
            <xs:enumeration value="always"/>
            <xs:enumeration value="never"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="OnFailureEnum">
        <xs:union memberTypes="OnFailureFixed OnFailureBusiness"/>
    </xs:simpleType>

    <xs:simpleType name="OnFailureFixed">
        <xs:restriction base="xs:string">
            <xs:enumeration value="incident"/>
            <xs:enumeration value="continue"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="OnFailureBusiness">
        <xs:restriction base="xs:string">
            <xs:pattern value="error:[A-Z0-9_]+"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ========= Shared Elements ========= -->

    <xs:element name="var">
        <xs:complexType>
            <xs:attribute name="name" use="required" type="xs:string"/>
            <xs:attribute name="inOutType" use="required">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:enumeration value="inner"/>
                        <xs:enumeration value="param"/>
                        <xs:enumeration value="return"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="description" type="xs:string"/>
            <xs:attribute name="defaultValue" type="xs:string"/>
            <xs:attribute name="dataType" use="required" type="xs:string"/>
            <xs:attribute name="contextVarName" type="xs:string"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="jobPolicy">
        <xs:complexType>
            <xs:attribute name="timeout" type="xs:duration"/>
            <xs:attribute name="retry" type="RetryCycle"/>
            <xs:attribute name="retryOn" type="RetryOnEnum"/>
            <xs:attribute name="onFailure" type="OnFailureEnum"/>
            <xs:attribute name="defaults" type="xs:string"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="transition">
        <xs:complexType>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="to" type="xs:string" use="required"/>
            <xs:attribute name="priority" type="xs:integer"/>
            <xs:attribute name="g" type="xs:string"/>
            <xs:attribute name="expression" type="xs:string"/>
        </xs:complexType>
    </xs:element>

    <!-- ========= Timers / Timeout ========= -->

    <xs:element name="timeout">
        <xs:complexType>
            <!-- XSD 1.0: mutual exclusivity between the three attributes must be checked at runtime -->
            <xs:attribute name="timeDate" type="xs:dateTime"/>
            <xs:attribute name="timeDuration" type="xs:duration"/>
            <xs:attribute name="timeCycle" type="TimeCycle"/>
        </xs:complexType>
    </xs:element>

    <!-- ========= Action & Code ========= -->

    <xs:element name="imports">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="import" type="xs:string" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="code">
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="xs:string">
                    <xs:attribute name="mode">
                        <xs:simpleType>
                            <xs:restriction base="xs:string">
                                <xs:enumeration value="block"/>
                                <xs:enumeration value="expr"/>
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="ref" type="xs:string"/>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>

    <!-- Free order: var/imports/code in any order and count (enforce counts at runtime if needed) -->
    <xs:element name="actionHandle">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="var"/>
                <xs:element ref="imports"/>
                <xs:element ref="code"/>
            </xs:choice>
            <xs:attribute name="method" type="xs:string"/>
            <xs:attribute name="clazz" type="xs:string"/>
            <xs:attribute name="bean" type="xs:string"/>
            <xs:attribute name="expression" type="xs:string"/>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="actionType">
        <xs:sequence>
            <xs:element ref="actionHandle"/>
        </xs:sequence>
        <xs:attribute name="type" use="required">
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="java"/>
                    <xs:enumeration value="spring-bean"/>
                    <xs:enumeration value="ql"/>
                    <xs:enumeration value="mvel"/>
                    <xs:enumeration value="groovy"/>
                    <xs:enumeration value="java-inline"/>
                    <xs:enumeration value="java-source"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:complexType>

    <xs:element name="action" type="actionType"/>
    <xs:element name="inAction" type="actionType"/>
    <xs:element name="outAction" type="actionType"/>

    <!-- ========= Head / Tail ========= -->

    <xs:element name="start">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="transition"/>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="tag" type="xs:string"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="end">
        <xs:complexType>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="tag" type="xs:string"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <!-- ========= Activities / Gateways / Containers ========= -->

    <xs:element name="autoTask">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="transition"/>
                <xs:element ref="action"/>
                <xs:element ref="jobPolicy"/>
            </xs:choice>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="tag" type="xs:string"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="scriptTask">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="transition"/>
                <xs:element ref="action"/>
                <xs:element ref="jobPolicy"/>
            </xs:choice>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="tag" type="xs:string"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="decision">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="transition"/>
                <xs:element ref="action"/>
            </xs:choice>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="tag" type="xs:string"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="parallel">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="transition"/>
                <xs:element ref="action"/>
            </xs:choice>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="tag" type="xs:string"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="inclusive">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="transition"/>
                <xs:element ref="action"/>
            </xs:choice>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="tag" type="xs:string"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="waitEventTask">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="inAction"/>
                <xs:element ref="outAction"/>
                <xs:element ref="transition"/>
            </xs:choice>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="tag" type="xs:string" use="required"/>
            <xs:attribute name="event" type="xs:string" use="required"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="userTask">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="user"/>
                <xs:element ref="timeout"/>
                <xs:element ref="inAction"/>
                <xs:element ref="outAction"/>
                <xs:element ref="transition"/>
            </xs:choice>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="tag" type="xs:string"/>
            <xs:attribute name="priority" type="xs:string"/>
            <xs:attribute name="formKey" type="xs:string"/>
            <xs:attribute name="counterSign" type="xs:string"/>
            <xs:attribute name="voteNum" type="xs:string"/>
            <xs:attribute name="assignType" type="xs:string"/>
            <xs:attribute name="judgeType" type="xs:string"/>
            <xs:attribute name="voteRule" type="xs:string"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="waitTask">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="inAction"/>
                <xs:element ref="outAction"/>
                <xs:element ref="transition"/>
            </xs:choice>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="tag" type="xs:string" use="required"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="signal">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="transition"/>
            </xs:choice>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="tag" type="xs:string"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="eventTask">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="transition"/>
            </xs:choice>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="tag" type="xs:string"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="loopProcess">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="continue"/>
                <xs:element ref="break"/>
                <xs:element ref="transition"/>
                <xs:element ref="autoTask"/>
                <xs:element ref="scriptTask"/>
                <xs:element ref="waitEventTask"/>
                <xs:element ref="decision"/>
                <xs:element ref="parallel"/>
                <xs:element ref="inclusive"/>
                <xs:element ref="loopProcess"/>
                <xs:element ref="subBpm"/>
                <xs:element ref="noop"/>
            </xs:choice>
            <xs:attribute name="variableClass" type="xs:string"/>
            <xs:attribute name="variableName" type="xs:string"/>
            <xs:attribute name="startNodeId" type="xs:string" use="required"/>
            <xs:attribute name="endNodeId" type="xs:string" use="required"/>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="loopType" type="xs:string"/>
            <xs:attribute name="whileExpression" type="xs:string"/>
            <xs:attribute name="indexVarName" type="xs:string"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
            <xs:attribute name="tag" type="xs:string"/>
            <xs:attribute name="collectionVarName" type="xs:string"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="continue">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="transition" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
            <xs:attribute name="expression" type="xs:string"/>
            <xs:attribute name="tag" type="xs:string"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="break">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="transition" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
            <xs:attribute name="expression" type="xs:string"/>
            <xs:attribute name="tag" type="xs:string"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="subBpm">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="var"/>
                <xs:element ref="transition"/>
            </xs:choice>
            <xs:attribute name="waitForCompletion" type="xs:boolean" use="required"/>
            <xs:attribute name="waitForTrigger" type="xs:boolean"/>
            <xs:attribute name="type" use="required">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:enumeration value="process"/>
                        <xs:enumeration value="statefulProcess"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="subBpmCode" type="xs:string" use="required"/>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="tag" type="xs:string"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="transaction">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="continue"/>
                <xs:element ref="break"/>
                <xs:element ref="transition"/>
                <xs:element ref="autoTask"/>
                <xs:element ref="scriptTask"/>
                <xs:element ref="decision"/>
                <xs:element ref="parallel"/>
                <xs:element ref="inclusive"/>
                <xs:element ref="loopProcess"/>
                <xs:element ref="transaction"/>
                <xs:element ref="subBpm"/>
                <xs:element ref="noop"/>
                <xs:element ref="waitEventTask"/>
            </xs:choice>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="transactionType" type="xs:string"/>
            <xs:attribute name="startNodeId" type="xs:string" use="required"/>
            <xs:attribute name="endNodeId" type="xs:string" use="required"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="timerTask">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="action"/>
                <xs:element ref="timeout"/>
                <xs:element ref="transition"/>
            </xs:choice>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="tag" type="xs:string"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="user">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="action"/>
            </xs:choice>
            <xs:attribute name="groupId" type="xs:string"/>
            <xs:attribute name="userId" type="xs:string"/>
            <xs:attribute name="userType" type="xs:string"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="monitor">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="action"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="note">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="transition"/>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="comment" type="xs:string"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="visible" type="xs:boolean" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="noop">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="transition" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="tag" type="xs:string"/>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="g" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <!-- ========= Root ========= -->

    <xs:element name="bpm">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="monitor"/>
                <xs:element ref="var"/>
                <xs:element ref="start"/>
                <xs:element ref="autoTask"/>
                <xs:element ref="decision"/>
                <xs:element ref="parallel"/>
                <xs:element ref="inclusive"/>
                <xs:element ref="scriptTask"/>
                <xs:element ref="loopProcess"/>
                <xs:element ref="transaction"/>
                <xs:element ref="timerTask"/>
                <xs:element ref="userTask"/>
                <xs:element ref="waitTask"/>
                <xs:element ref="signal"/>
                <xs:element ref="eventTask"/>
                <xs:element ref="waitEventTask"/>
                <xs:element ref="subBpm"/>
                <xs:element ref="timeout"/>
                <xs:element ref="end"/>
                <xs:element ref="note"/>
                <xs:element ref="noop"/>
            </xs:choice>
            <xs:attribute name="type" use="required">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:enumeration value="process"/>
                        <xs:enumeration value="statefulProcess"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="domain" type="xs:string"/>
            <xs:attribute name="description" type="xs:string"/>
            <xs:attribute name="maxFlow" type="xs:string"/>
            <xs:attribute name="code" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

</xs:schema>
