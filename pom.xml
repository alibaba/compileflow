                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>

                <!-- Code quality plugins -->
                <!-- Checkstyle: repository formatting and API documentation rules -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${maven-checkstyle-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>${checkstyle.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <configLocation>${checkstyle.config.location}</configLocation>
                        <propertyExpansion>checkstyle.header.file=${checkstyle.header.file}</propertyExpansion>
                        <consoleOutput>true</consoleOutput>
                        <includeTestSourceDirectory>true</includeTestSourceDirectory>
                        <excludeGeneratedSources>true</excludeGeneratedSources>
                        <failsOnError>true</failsOnError>
                        <failOnViolation>true</failOnViolation>
                        <violationSeverity>error</violationSeverity>
                        <linkXRef>false</linkXRef>
                    </configuration>
                </plugin>

                <!-- JaCoCo: test coverage reports and module-specific thresholds -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                    <configuration>
                        <excludes>
                            <!-- Exclude generated code -->
                            <exclude>**/generated/**</exclude>
                            <exclude>**/*$$*.class</exclude>
                        </excludes>
                    </configuration>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!--
                    Spotless: compact WIDE 120-column Java formatting via Prince of Space.
                    Bound to the verify phase so `mvn verify` enforces formatting in CI
                    and local builds; use `mvn spotless:apply` to auto-fix violations.
                -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-maven-plugin.version}</version>
                    <configuration>
                        <java>
                            <includes>
                                <include>src/main/java/**/*.java</include>
                                <include>src/test/java/**/*.java</include>
                            </includes>
                            <princeOfSpace>
                                <version>${prince-of-space.version}</version>
                                <indentStyle>SPACES</indentStyle>
                                <indentSize>4</indentSize>
                                <lineLength>120</lineLength>
                                <wrapStyle>WIDE</wrapStyle>
                                <closingParenOnNewLine>false</closingParenOnNewLine>
                                <trailingCommas>false</trailingCommas>
                                <javaLanguageLevel>17</javaLanguageLevel>
                            </princeOfSpace>
                            <removeUnusedImports/>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>
                    </configuration>
                    <executions>
                        <execution>
                            <id>spotless-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- SpotBugs: Static code analysis - FindBugs successor -->
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-maven-plugin.version}</version>
                    <configuration>
                        <effort>Max</effort>
                        <threshold>Medium</threshold>
                        <failOnError>true</failOnError>
                        <maxRank>15</maxRank>
                        <xmlOutput>true</xmlOutput>
                        <spotbugsXmlOutputDirectory>${project.build.directory}</spotbugsXmlOutputDirectory>
                        <excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs-exclude.xml</excludeFilterFile>
                    </configuration>
                    <executions>
                        <execution>
                            <id>spotbugs-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- CycloneDX: aggregate software bill of materials for release and security review -->
                <plugin>
                    <groupId>org.cyclonedx</groupId>
                    <artifactId>cyclonedx-maven-plugin</artifactId>
                    <version>${cyclonedx-maven-plugin.version}</version>
                    <configuration>
                        <projectType>library</projectType>
                        <schemaVersion>1.6</schemaVersion>
                        <includeTestScope>false</includeTestScope>
                        <includeLicenseText>false</includeLicenseText>
                        <outputFormat>json</outputFormat>
                        <outputName>compileflow-bom</outputName>
                        <outputReactorProjects>false</outputReactorProjects>
                        <skipAttach>true</skipAttach>
                    </configuration>
                </plugin>

                <!-- JavaDoc: API documentation generation -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                    <configuration>
                        <source>${maven.compiler.release}</source>
                        <show>public</show>
                        <charset>UTF-8</charset>
                        <encoding>UTF-8</encoding>
                        <docencoding>UTF-8</docencoding>
                        <failOnError>true</failOnError>
                        <failOnWarnings>true</failOnWarnings>
                        <!-- Missing-doc coverage is enforced by the API-aware
                             Checkstyle gate. Keep reference, HTML, and syntax
                             validation strict for direct Javadoc goals. -->
                        <doclint>all,-missing</doclint>
                        <additionalJOptions>
                            <additionalJOption>-quiet</additionalJOption>
                            <additionalJOption>-J-Duser.language=en</additionalJOption>
                            <additionalJOption>-J-Duser.country=US</additionalJOption>
                        </additionalJOptions>
                        <tags>
                            <tag>
                                <name>apiNote</name>
                                <placement>a</placement>
                                <head>API Note:</head>
                            </tag>
                            <tag>
                                <name>implSpec</name>
                                <placement>a</placement>
                                <head>Implementation Requirements:</head>
                            </tag>
                            <tag>
                                <name>implNote</name>
                                <placement>a</placement>
                                <head>Implementation Note:</head>
                            </tag>
                        </tags>
                    </configuration>
                    <executions>
                        <execution>
                            <id>aggregate</id>
                            <goals>
                                <goal>aggregate</goal>
                            </goals>
                            <phase>site</phase>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Security scan profile (for CI/CD) -->
        <profile>
            <id>security-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency-check-maven-plugin.version}</version>
                        <configuration>
                            <failBuildOnCVSS>7.0</failBuildOnCVSS>
                            <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                            <skipTestScope>true</skipTestScope>
                            <skipProvidedScope>true</skipProvidedScope>
                            <skipRuntimeScope>false</skipRuntimeScope>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Attach the sources and Javadoc required by Maven Central. -->
        <profile>
            <id>release-artifacts</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-checkstyle-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>release-checkstyle</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadoc</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <source>${maven.compiler.release}</source>
                            <show>public</show>
                            <charset>UTF-8</charset>
                            <encoding>UTF-8</encoding>
                            <docencoding>UTF-8</docencoding>
                            <failOnError>true</failOnError>
                            <failOnWarnings>true</failOnWarnings>
                            <!-- Implementation packages outside the supported API are not public
                                 API. Keep reference/HTML checks while allowing undocumented details. -->
                            <doclint>all,-missing</doclint>
                            <additionalJOptions>
                                <additionalJOption>-quiet</additionalJOption>
                                <additionalJOption>-J-Duser.language=en</additionalJOption>
                                <additionalJOption>-J-Duser.country=US</additionalJOption>
                            </additionalJOptions>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Sign artifacts only when explicitly publishing to a repository. -->
        <profile>
            <id>sign-artifacts</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Publish release bundles to Maven Central Portal only when explicitly requested. -->
        <profile>
            <id>publish-central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Examples profile: build the runnable samples. Not active by default so the
            core/release build stays lean. Use `-Pexamples` from the reactor root.
            CI exercises this profile on every push that touches examples/ or this pom.
        -->
        <profile>
            <id>examples</id>
            <modules>
                <module>examples/spring-boot-basic</module>
                <module>examples/spring-boot-order-fulfillment</module>
                <module>examples/spring-boot-deployment</module>
                <module>examples/spring-boot-durable-postgresql</module>
            </modules>
        </profile>

        <!--
            Benchmarks profile: JMH benchmarks for the engine. Not active by default so
            the default CI run stays lean. Use `-Pbenchmarks -pl compileflow-benchmarks` to build and
            `java -jar compileflow-benchmarks/target/compileflow-benchmarks.jar` to run.
        -->
        <profile>
            <id>benchmarks</id>
            <modules>
                <module>compileflow-benchmarks</module>
            </modules>
        </profile>
    </profiles>
</project>
