<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- JMH annotation processing owns these harness classes; project source remains analyzed. -->
    <Match>
        <Package name="com.alibaba.compileflow.benchmarks.jmh_generated"/>
    </Match>

    <!-- Query shape is composed only from fixed SQL fragments and placeholders. -->
    <Match>
        <Class name="com.alibaba.compileflow.durable.postgres.PostgresDurableStore"/>
        <Method name="~(listRuns|listOutbox)"/>
        <Bug pattern="SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING"/>
    </Match>

    <!-- The relation is selected from an exhaustive allowlist; run IDs remain bound parameters. -->
    <Match>
        <Class name="com.alibaba.compileflow.durable.postgres.PostgresDurableStore"/>
        <Method name="deleteRunRows"/>
        <Bug pattern="SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING"/>
    </Match>
</FindBugsFilter>
