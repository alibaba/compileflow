root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
tab_width = 4
indent_style = space
trim_trailing_whitespace = true

[*.java]
indent_size = 4

[*.xml]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[*.{md,mkd,markdown}]
indent_size = 4
trim_trailing_whitespace = false
