# Local Compose database. The name and user are optional; the password is required.
# Leave the password empty when using `pnpm up:all-in-one` — the script fills it.
COMPILEFLOW_WORKBENCH_DATABASE_NAME=compileflow
COMPILEFLOW_WORKBENCH_DATABASE_USERNAME=compileflow
COMPILEFLOW_WORKBENCH_DATABASE_PASSWORD=

# Split deployment only: one server-side key shared by Workbench Server and the
# loopback local gateway. Generate 32 or more URL-safe ASCII characters, for
# example with `openssl rand -hex 32`. Never put this value in VITE_* variables.
COMPILEFLOW_WORKBENCH_SERVER_CONFIG_AUTHENTICATION_API_KEY=

# Stable audit identity represented by the local gateway API key.
COMPILEFLOW_WORKBENCH_SERVER_CONFIG_AUTHENTICATION_SERVICE_PRINCIPAL=workbench-local-gateway

# Trusted server-side draft execution. Keep false outside controlled authoring environments.
COMPILEFLOW_WORKBENCH_SERVER_CONFIG_PREVIEW_EXECUTION_ENABLED=false

# Optional public Web build inputs.
VITE_COMPILEFLOW_DEBUG=false
VITE_COMPILEFLOW_USE_BUILT_IN_EXAMPLES=false
