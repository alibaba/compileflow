FROM node:24.18.0-alpine3.24@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd AS build
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
RUN corepack enable && corepack install
RUN pnpm install --frozen-lockfile --filter @compileflow/workbench-web
COPY apps/web apps/web
ARG VITE_COMPILEFLOW_OPERATE_MODE=real
ARG VITE_COMPILEFLOW_DEBUG=false
ARG VITE_COMPILEFLOW_USE_BUILT_IN_EXAMPLES=false
ENV VITE_COMPILEFLOW_OPERATE_MODE=$VITE_COMPILEFLOW_OPERATE_MODE
ENV VITE_COMPILEFLOW_DEBUG=$VITE_COMPILEFLOW_DEBUG
ENV VITE_COMPILEFLOW_USE_BUILT_IN_EXAMPLES=$VITE_COMPILEFLOW_USE_BUILT_IN_EXAMPLES
RUN pnpm --filter @compileflow/workbench-web build

FROM nginx:1.30.4-alpine3.24@sha256:97d490c12ba55b4946b01546d1c3ed324e8d41ab1c9fcb2a616aa470620e5b46
RUN chown -R nginx:nginx /var/cache/nginx /var/run /var/log/nginx
COPY docker/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
USER nginx
EXPOSE 8080
