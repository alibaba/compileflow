# Loopback-only Workbench development gateway.
# Production deployment is intentionally unsupported.

# COMPILEFLOW_DEV_GATEWAY_PORT=3001

# Structured log threshold: error, warn, info, or debug.
# COMPILEFLOW_DEV_GATEWAY_LOG_LEVEL=info

# JSON request limit in bytes; default and maximum 10 MiB.
# COMPILEFLOW_DEV_GATEWAY_MAX_REQUEST_BYTES=10485760

# Integration test overrides.
# DEV_GATEWAY_TEST_URL=http://127.0.0.1:3001
# DEV_GATEWAY_TEST_TIMEOUT=20000
