# CompileFlow Workbench public build inputs.
# Copy this file to .env.local when a local build override is needed.
# API, platform, and health requests always use same-origin routes.

# Operate mode: 'mock' serves local demo data; 'real' hits the backend API
# Default: 'mock' in development, 'real' in production
# VITE_COMPILEFLOW_OPERATE_MODE=mock

# Use the Workbench's built-in Learn examples instead of loading /api/examples
# Default: true in mock mode, false in real mode
# Mock mode requires this setting to remain true
# VITE_COMPILEFLOW_USE_BUILT_IN_EXAMPLES=true

# Enable debug logging in browser console
# Default: false
# VITE_COMPILEFLOW_DEBUG=false

# App version comes from apps/web/package.json and cannot be overridden here.
