# Development environment configuration
# These variables are loaded by Vite when running `pnpm dev` (MODE=development).

# Browser calls use same-origin /api and /health. The Vite development proxy owns routing.

# Operate mode: 'mock' serves local demo data; 'real' hits the backend API
# Default in development: mock (explorable without Spring Boot). Set to real when backend is up.
VITE_COMPILEFLOW_OPERATE_MODE=mock

# The development gateway has no Server-side Learn catalog.
VITE_COMPILEFLOW_USE_BUILT_IN_EXAMPLES=true
